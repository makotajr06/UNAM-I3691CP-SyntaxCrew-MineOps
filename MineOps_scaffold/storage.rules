rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    function isPdf() {
      return request.resource != null
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < 25 * 1024 * 1024;
    }

    function isImageOrPdf() {
      return isImage() || isPdf();
    }

    match /profiles/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && isImage();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /hazards/{hazardId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isImage();
      allow delete: if signedIn();
    }

    match /inspections/{inspectionId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isImageOrPdf();
      allow delete: if signedIn();
    }

    match /reports/{reportId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isPdf();
      allow delete: if signedIn();
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && isImageOrPdf();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
